# Copy to functions/.env before deploying.
# Gemini models, best first. If one is overloaded (503) or times out, the next is tried.
# VERIFY current model names: https://ai.google.dev/gemini-api/docs/models
# (Tested 2026-10-22: gemini-2.5-flash is no longer available to new API keys.)
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-latest

# App Check is enforced by default. Set to false ONLY for the local emulator.
# REQUIRE_APP_CHECK=false
